# Copy this to .env and fill in real values. NEVER commit the real .env.

RPC_URL=https://polygon-rpc.com
PRIVATE_KEY=
CONTRACT_ADDRESS=
DRY_RUN=true

# --- Fork testing (Foundry auto-loads this file) ---
# Needs an archive-capable provider; public full nodes cannot serve old state.
FORK_RPC_URL=
# Pinned block for reproducible runs. Set to 0 to fork from latest.
FORK_BLOCK=91000000

# --- Submission mode: public | flashbots | private_rpc ---
SUBMISSION_MODE=public

# Flashbots (ETHEREUM ONLY — no relay exists on Polygon).
# Throwaway reputation key. NOT your funding key, holds no balance.
FLASHBOTS_SIGNING_KEY=

# Private RPC for SUBMISSION_MODE=private_rpc — the Polygon-compatible path.
# e.g. Fastlane, bloXroute, or Merkle endpoint.
PRIVATE_RPC_URL=
